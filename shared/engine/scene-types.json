{
  "$schema": "./scene-types.schema.json",
  "version": 1,
  "status": "approved",
  "coordinateSpace": "normalized-safe-area",
  "about": "Approved minimal cross-platform scene contract for SSL-615. Human-authored scene and mission instances use TOML; rectangles use x/y/w/h in a 0..1 safe-area coordinate space.",
  "sharedSlots": {
    "hud": { "x": 0.02, "y": 0.02, "w": 0.96, "h": 0.1, "layer": "chrome" },
    "objective": { "x": 0.16, "y": 0.13, "w": 0.68, "h": 0.08, "layer": "chrome" },
    "primaryAction": { "x": 0.62, "y": 0.82, "w": 0.36, "h": 0.14, "layer": "controls" },
    "secondaryAction": { "x": 0.02, "y": 0.82, "w": 0.36, "h": 0.14, "layer": "controls" },
    "world": { "x": 0, "y": 0, "w": 1, "h": 1, "layer": "world" },
    "modal": { "x": 0.08, "y": 0.12, "w": 0.84, "h": 0.76, "layer": "overlay" }
  },
  "sceneTypes": {
    "base": {
      "description": "Pan/zoom home world with buildings and fixed sites.",
      "slots": ["world", "hud", "objective", "primaryAction", "secondaryAction", "modal"],
      "routes": ["build", "hub", "hub-subsurface", "launchpad"]
    },
    "travel": {
      "description": "Launch, transit, landing, delivery, return and debrief views.",
      "slots": ["world", "hud", "objective", "primaryAction", "secondaryAction", "modal"],
      "routes": ["fab", "transit", "landing", "delivery", "debrief"]
    },
    "field": {
      "description": "Direct-control mining, rover and surface operations.",
      "slots": ["world", "hud", "objective", "primaryAction", "secondaryAction", "modal"],
      "routes": ["mining", "rover-survey", "surface-ops"]
    },
    "build": {
      "description": "Assembly and customisation around a physical vehicle or structure.",
      "slots": ["world", "hud", "objective", "primaryAction", "secondaryAction", "modal"],
      "routes": ["hangar", "rocket-buy"]
    },
    "exchange-lab": {
      "description": "In-world instruments, trading and processing surfaces.",
      "slots": ["world", "hud", "objective", "primaryAction", "secondaryAction", "modal"],
      "routes": ["academy", "asteroid-discovery", "galaxy", "instrument-hub", "market", "refinery", "saturn-storm-search"]
    },
    "menu": {
      "description": "Reference, selection and record surfaces; cards are allowed here.",
      "slots": ["world", "hud", "objective", "primaryAction", "secondaryAction", "modal"],
      "routes": ["intro", "mission-history", "missions", "narrative-ledger", "skills", "targets"]
    }
  },
  "objectContract": {
    "required": ["id", "kind", "slot"],
    "optional": ["prefab", "anchor", "children", "components", "bindings"],
    "rule": "Scene files own structure and placement; platform code owns behavior and rendering adapters."
  }
}
