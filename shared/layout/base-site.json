    "width": 520
  },
  "kitScale": {
    "phone": 2,
    "large": 3,
    "largeMinHeight": 600,
    "portraitFit": 250,
    "portraitMin": 1.5,
    "rule": "Portrait: view width / portraitFit, kept between portraitMin and phone, so the hangar and pad both fit. Landscape: phone (2) under 600 pt tall, else large (3)."
  },
