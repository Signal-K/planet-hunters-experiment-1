{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Edit(./**)",
      "Bash(git *)",
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(node *)",
      "Bash(make *)",
      "Bash(go *)",
      "Bash(scripts/*)",
      "Bash(./scripts/*)",
      "Bash(curl -s*localhost*)",
      "Bash(rg *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(sed -n *)",
      "Bash(grep *)",
      "mcp__Linear",
      "mcp__Craft__craft_read",
      "ArtifactData",
      "SendUserFile"
    ],
    "deny": [
      "mcp__Linear__delete_comment",
      "mcp__Linear__delete_attachment",
      "mcp__Linear__delete_status_update",
      "mcp__Linear__delete_diff_comment",
      "mcp__Linear__merge_diff",
      "Read(./web/node_modules/**)",
      "Read(./node_modules/**)",
      "Read(./web/.next/**)",
      "Read(./web/.open-next/**)",
      "Read(./web/.wrangler/**)",
      "Read(./native/**/.build/**)",
      "Read(./**/DerivedData/**)",
      "Read(./native/Landnam.xcodeproj/**)",
      "Read(./web/tests/.out/**)",
      "Read(./web/tests/.report/**)",
      "Read(./**/test-results/**)",
      "Read(./pocketbase/pb_data/**)",
      "Read(./web/package-lock.json)",
      "Read(./pocketbase/go.sum)",
      "Read(./native/App/Theme.generated.swift)",
      "Read(./**/*-sheet.json)",
      "Read(./web/public/game/assets/**)",
      "Read(./native/App/Resources/Art/**)",
      "Read(./native/App/Assets.xcassets/**)",
      "Read(./web/vendor/**)",
      "Read(./.agents/skills/landnam-design/_ds_bundle.js)",
      "Read(./.agents/skills/landnam-design/_ds_manifest.json)",
      "Read(./.agents/skills/landnam-design/ui_kits/landnam-portrait/screens-pre.tsx)",
      "Read(./**/*.log)",
      "Read(./.env)",
      "Read(./web/.env*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/preview-target.mjs\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && (scripts/ensure-stack.sh >/tmp/landnam-ensure.log 2>&1 &) ; echo 'Landnam stack ensured in the background (never restarted if healthy, and left running when sessions end). Live preview: open http://localhost:4320/game/hub?follow=1 in the Simple Browser (Cmd+Shift+P, Simple Browser: Show). Fast check in that tab: node scripts/dev-check.mjs <name> (see --list).'"
          }
        ]
      }
    ]
  }
}
