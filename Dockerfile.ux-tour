# Dockerfile.ux-tour
# Minimal image for running the Godot UX E2E screenshot tour locally.
# Does NOT include Node/npm — keeps the image lean and fast to build.
# Scene source is mounted at runtime so code changes don't need a rebuild.
FROM --platform=linux/amd64 ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive
ARG GODOT_VERSION=4.5-stable

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    unzip \
    xvfb \
    libgl1 \
    libgles2 \
    libx11-6 \
    libxcursor1 \
    libxinerama1 \
    libxrandr2 \
    libxrender1 \
    libxi6 \
    && rm -rf /var/lib/apt/lists/*

# Install Godot binary
RUN mkdir -p /opt/godot && \
    curl -fsSL -o /tmp/godot.zip \
      "https://github.com/godotengine/godot/releases/download/${GODOT_VERSION}/Godot_v${GODOT_VERSION}_linux.x86_64.zip" && \
    unzip -q /tmp/godot.zip -d /opt/godot && \
    mv /opt/godot/Godot_v${GODOT_VERSION}_linux.x86_64 /opt/godot/godot && \
    chmod +x /opt/godot/godot && \
    rm /tmp/godot.zip

ENV PATH="/opt/godot:${PATH}"

WORKDIR /app

# Scene source is mounted at /app/scene at runtime (see Makefile ux-tour target).
# /output is the mount point where screenshots are written.
RUN mkdir -p /output

COPY docker/ux-tour-entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]
