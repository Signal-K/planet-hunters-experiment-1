# Dockerfile.ux-tour
# Minimal image for running the Godot UX E2E screenshot tour locally.
# Does NOT include Node/npm — keeps the image lean and fast to build.
# Scene source is mounted at runtime so code changes don't need a rebuild.
#
# Builds native on both linux/amd64 and linux/arm64.
# On Apple Silicon run `make ux-tour-build` to get a native arm64 image.
FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive
ARG GODOT_VERSION=4.5-stable
ARG TARGETARCH

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    unzip \
    xvfb \
    libfontconfig1 \
    libxkbcommon0 \
    libdbus-1-3 \
    libasound2 \
    libpulse0 \
    libgl1 \
    libgles2 \
    libx11-6 \
    libxcursor1 \
    libxinerama1 \
    libxrandr2 \
    libxrender1 \
    libxi6 \
    && rm -rf /var/lib/apt/lists/*

COPY .godot-bin/ /tmp/godot-cache/

# Install Godot binary — prefer repo-cached artifacts before any network fetch.
RUN mkdir -p /opt/godot && \
    if [ "$TARGETARCH" = "arm64" ]; then \
        GODOT_FILE="Godot_v${GODOT_VERSION}_linux.arm64"; \
    else \
        GODOT_FILE="Godot_v${GODOT_VERSION}_linux.x86_64"; \
    fi && \
    if [ -x "/tmp/godot-cache/${GODOT_FILE}" ]; then \
        cp "/tmp/godot-cache/${GODOT_FILE}" /opt/godot/godot; \
    elif [ -f "/tmp/godot-cache/godot.zip" ]; then \
        unzip -q "/tmp/godot-cache/godot.zip" -d /opt/godot && \
        mv "/opt/godot/${GODOT_FILE}" /opt/godot/godot; \
    else \
        curl -fsSL -o /tmp/godot.zip \
          "https://github.com/godotengine/godot/releases/download/${GODOT_VERSION}/${GODOT_FILE}.zip" && \
        unzip -q /tmp/godot.zip -d /opt/godot && \
        mv "/opt/godot/${GODOT_FILE}" /opt/godot/godot && \
        rm /tmp/godot.zip; \
    fi && \
    chmod +x /opt/godot/godot && \
    rm -rf /tmp/godot-cache

ENV PATH="/opt/godot:${PATH}"

WORKDIR /app

# Scene source is mounted at /app/scene at runtime (see Makefile ux-tour target).
# /output is the mount point where screenshots are written.
RUN mkdir -p /output

COPY docker/ux-tour-entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]
