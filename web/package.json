{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p ${PORT:-3001}",
    "build": "next build",
    "build:cf": "opennextjs-cloudflare build",
    "preview:cf": "opennextjs-cloudflare preview",
    "deploy:cf": "opennextjs-cloudflare build && wrangler deploy",
    "start": "next start -p 3001",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "missions:emit": "node --experimental-strip-types scripts/generate-missions.ts",
    "cypress:open": "env -u ELECTRON_RUN_AS_NODE cypress open",
    "cypress:run": "env -u ELECTRON_RUN_AS_NODE cypress run",
    "cypress:run:regression": "env -u ELECTRON_RUN_AS_NODE CYPRESS_PROFILE=regression cypress run",
    "cypress:run:journeys": "env -u ELECTRON_RUN_AS_NODE CYPRESS_PROFILE=journeys cypress run",
    "cypress:run:features": "env -u ELECTRON_RUN_AS_NODE CYPRESS_PROFILE=features cypress run",
    "cypress:run:auth": "env -u ELECTRON_RUN_AS_NODE CYPRESS_PROFILE=auth cypress run",
    "cypress:run:full": "env -u ELECTRON_RUN_AS_NODE CYPRESS_PROFILE=full cypress run",
    "cypress:run:tutorial-rail": "env -u ELECTRON_RUN_AS_NODE CYPRESS_PROFILE=tutorial-rail cypress run",
    "cypress:run:interaction-order": "env -u ELECTRON_RUN_AS_NODE CYPRESS_PROFILE=interaction-order cypress run",
    "cypress:run:ui-zones": "env -u ELECTRON_RUN_AS_NODE CYPRESS_PROFILE=ui-zones cypress run",
    "cypress:run:clean-start-loop": "env -u ELECTRON_RUN_AS_NODE CYPRESS_PROFILE=clean-start-loop cypress run",
    "cypress:run:surveys": "env -u ELECTRON_RUN_AS_NODE CYPRESS_PROFILE=surveys cypress run",
    "test:e2e": "CYPRESS_PROFILE=offline start-server-and-test dev http://localhost:3001 cypress:run",
    "test:e2e:regression": "CYPRESS_PROFILE=regression start-server-and-test dev http://localhost:3001 cypress:run:regression",
    "test:e2e:journeys": "CYPRESS_PROFILE=journeys start-server-and-test dev http://localhost:3001 cypress:run:journeys",
    "test:e2e:features": "CYPRESS_PROFILE=features start-server-and-test dev http://localhost:3001 cypress:run:features",
    "test:e2e:auth": "CYPRESS_PROFILE=auth start-server-and-test dev http://localhost:3001 cypress:run:auth",
    "test:e2e:full": "CYPRESS_PROFILE=full start-server-and-test dev http://localhost:3001 cypress:run:full",
    "test:e2e:tutorial-rail": "CYPRESS_PROFILE=tutorial-rail start-server-and-test dev http://localhost:3001 cypress:run:tutorial-rail",
    "test:e2e:interaction-order": "CYPRESS_PROFILE=interaction-order start-server-and-test dev http://localhost:3001 cypress:run:interaction-order",
    "test:e2e:ui-zones": "CYPRESS_PROFILE=ui-zones start-server-and-test dev http://localhost:3001 cypress:run:ui-zones",
    "test:e2e:clean-start-loop": "CYPRESS_PROFILE=clean-start-loop start-server-and-test dev http://localhost:3001 cypress:run:clean-start-loop",
    "test:e2e:surveys": "CYPRESS_PROFILE=surveys start-server-and-test dev http://localhost:3001 cypress:run:surveys",
    "test:e2e:pb": "CYPRESS_PROFILE=with-pb start-server-and-test dev http://localhost:3001 cypress:run",
    "test:e2e:full:desktop": "CYPRESS_PROFILE=full CYPRESS_VIEWPORT=desktop start-server-and-test dev http://localhost:3001 cypress:run:full",
    "test:e2e:full:tablet": "CYPRESS_PROFILE=full CYPRESS_VIEWPORT=tablet start-server-and-test dev http://localhost:3001 cypress:run:full",
    "test:e2e:full:landscape": "CYPRESS_PROFILE=full CYPRESS_VIEWPORT=landscape start-server-and-test dev http://localhost:3001 cypress:run:full",
    "cypress:open:visual": "env -u ELECTRON_RUN_AS_NODE CYPRESS_PROFILE=visual cypress open --browser chrome",
    "cypress:run:visual": "node scripts/run-visual-cypress-safe.mjs",
    "cypress:run:release-matrix": "env -u ELECTRON_RUN_AS_NODE CYPRESS_PROFILE=visual CYPRESS_baseUrl=http://localhost:3001 cypress run --headless --browser chrome --spec cypress/e2e/visual/full-release-matrix.cy.ts",
    "cypress:run:release-matrix:mobile": "env -u ELECTRON_RUN_AS_NODE CYPRESS_PROFILE=visual CYPRESS_baseUrl=http://localhost:3001 CYPRESS_RELEASE_MATRIX_VIEWPORT=mobile-portrait cypress run --headless --browser chrome --spec cypress/e2e/visual/full-release-matrix.cy.ts",
    "test:e2e:release-matrix": "start-server-and-test dev http://localhost:3001 cypress:run:release-matrix",
    "test:e2e:release-matrix:mobile": "start-server-and-test dev http://localhost:3001 cypress:run:release-matrix:mobile",
    "cypress:run:takeon-visual": "env -u ELECTRON_RUN_AS_NODE CYPRESS_PROFILE=journeys CYPRESS_baseUrl=http://localhost:3001 cypress run --headless --browser chrome --spec cypress/e2e/journeys/takeon-visual-audit.cy.ts",
    "test:e2e:takeon-visual": "start-server-and-test dev http://localhost:3001 cypress:run:takeon-visual",
    "test:e2e:release-visual": "CYPRESS_PROFILE=visual CYPRESS_baseUrl=http://localhost:3001 start-server-and-test dev http://localhost:3001 \"cypress:run:visual -- --spec cypress/e2e/visual/full-release-matrix.cy.ts\"",
    "test:e2e:release-visual:mobile": "CYPRESS_PROFILE=visual CYPRESS_baseUrl=http://localhost:3001 CYPRESS_RELEASE_MATRIX_VIEWPORT=mobile-portrait start-server-and-test dev http://localhost:3001 \"cypress:run:visual -- --spec cypress/e2e/visual/full-release-matrix.cy.ts\""
  },
  "dependencies": {
    "@takeon/engine": "file:vendor/takeon/takeon-engine-0.2.0.tgz",
    "@takeon/pixi": "file:vendor/takeon/takeon-pixi-0.2.2.tgz",
    "lucide-react": "^1.17.0",
    "next": "16.2.12",
    "pixi.js": "^8.19.0",
    "pocketbase": "^0.27.0",
    "posthog-js": "^1.386.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "recharts": "^3.8.1",
    "resend": "^6.12.4",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.0.2",
    "cypress": "^15.16.0",
    "esbuild": "^0.28.2",
    "jsdom": "^29.1.1",
    "start-server-and-test": "^3.0.10",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.8",
    "wrangler": "^4.123.0"
  },
  "allowScripts": {
    "esbuild@0.25.4": true,
    "esbuild@0.28.2": true,
    "esbuild@0.28.1": true,
    "core-js@3.49.0": true,
    "cypress@15.16.0": true,
    "fsevents@2.3.3": true,
    "workerd@1.20260811.1": true
  }
}
