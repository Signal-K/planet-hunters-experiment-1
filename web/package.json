{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p ${PORT:-3001}",
    "build": "next build",
    "build:cf": "opennextjs-cloudflare build",
    "preview:cf": "opennextjs-cloudflare preview",
    "deploy:cf": "opennextjs-cloudflare build && wrangler deploy",
    "start": "next start -p 3001",
    "typecheck": "tsc --noEmit",
    "verify:scene-surfaces": "node scripts/verify-scene-surfaces.mjs",
    "verify:hue-palette": "node scripts/verify-hue-palette.mjs",
    "verify:native-text-floor": "node scripts/verify-native-text-floor.mjs",
    "verify:native-tap-targets": "node scripts/verify-native-tap-targets.mjs",
    "verify:native-contrast": "node scripts/verify-native-contrast.mjs",
    "verify:loop-text-floor": "node scripts/loop-text-floor.mjs",
    "qa:scenes": "node scripts/qa-scenes.mjs",
    "test:unit": "npm run verify:scene-surfaces && vitest run",
    "missions:emit": "node --experimental-strip-types scripts/generate-missions.ts",
    "ingest:shared-subjects": "node --experimental-strip-types scripts/run-shared-subject-ingest.ts",
    "lint:design-tokens": "node scripts/lint-design-tokens.mjs",
    "lint": "npm run lint:design-tokens && npm run verify:hue-palette && npm run verify:native-text-floor && npm run verify:native-tap-targets && npm run verify:native-contrast && npm run verify:scene-surfaces && npm run typecheck",
    "test:scenes": "playwright test scenes",
    "test:scenes:phone": "playwright test scenes --grep \"^phone\""
  },
  "dependencies": {
    "@takeon/engine": "file:vendor/takeon/takeon-engine-0.2.2.tgz",
    "@takeon/pixi": "file:vendor/takeon/takeon-pixi-0.2.2.tgz",
    "lucide-react": "^1.17.0",
    "next": "16.2.12",
    "pixi.js": "^8.19.0",
    "pocketbase": "^0.27.0",
    "posthog-js": "^1.386.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "recharts": "^3.8.1",
    "resend": "^6.12.4",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "@playwright/test": "^1.56.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.0.2",
    "esbuild": "^0.28.2",
    "jsdom": "^29.1.1",
    "start-server-and-test": "^3.0.10",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.8",
    "wrangler": "^4.123.0"
  },
  "allowScripts": {
    "esbuild@0.25.4": true,
    "esbuild@0.28.2": true,
    "esbuild@0.28.1": true,
    "core-js@3.49.0": true,
    "fsevents@2.3.3": true,
    "workerd@1.20260811.1": true
  }
}
