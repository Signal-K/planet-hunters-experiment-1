# Shared PocketBase (auth + citizen science): http://localhost:8090 in dev
NEXT_PUBLIC_SHARED_PB_URL=

# Landnam PocketBase (game data): http://localhost:8093 in dev
NEXT_PUBLIC_LANDNAM_PB_URL=

