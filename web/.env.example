# Both of these are inlined into the client bundle at BUILD time (Next.js
# NEXT_PUBLIC_* semantics) — setting them at runtime/in a hosting dashboard
# after the build has already run has no effect. Every deploy target (CI,
# Cloudflare Worker build, or any other host) must supply them at build time.
#
# If a deployed (non-localhost) build ships without these, it silently falls
# back to loopback URLs, which fail instantly on an HTTPS origin — see SSL-9.
# lib/pb-config.ts detects that case at runtime and renders "Feed Not
# Configured" instead of misreporting it as a transient outage.

NEXT_PUBLIC_SHARED_PB_URL=https://signal-k-starsailors.fly.dev
NEXT_PUBLIC_LANDNAM_PB_URL=https://signal-k-landnam.fly.dev
