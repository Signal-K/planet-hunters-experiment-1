# Build-time configuration for the web client.
#
# Next.js inlines every NEXT_PUBLIC_* value into the client bundle at BUILD
# time, so these must be set in the deploy platform's build environment (not
# only at runtime). A deploy built without them ships a bundle that points
# every player's browser at localhost: the game still loads from the service
# worker's cached shell, but every backend call fails — a permanent
# "NOT SYNCED" badge and "Live Feed Unavailable" on the telescope screens.
# See lib/pb-config.ts (KES-357).

# Shared backend — auth + citizen-science subjects (TESS / NEOCP feeds).
NEXT_PUBLIC_SHARED_PB_URL=http://localhost:8090

# Landnam game backend — game_states, catalog, mission log.
NEXT_PUBLIC_LANDNAM_PB_URL=http://localhost:8093

# Deployed values currently in use by CI (.github/workflows/web-ci.yml):
#   NEXT_PUBLIC_SHARED_PB_URL=https://signal-k-starsailors.fly.dev
#   NEXT_PUBLIC_LANDNAM_PB_URL=https://signal-k-landnam.fly.dev
