{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "landnam-web",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "routes": [
    { "pattern": "playlandnam.space", "custom_domain": true },
    { "pattern": "www.playlandnam.space", "custom_domain": true }
  ],
  "observability": {
    "enabled": true
  },
  "vars": {
    "NEXT_PUBLIC_SHARED_PB_URL": "https://signal-k-starsailors.fly.dev",
    "NEXT_PUBLIC_LANDNAM_PB_URL": "https://signal-k-landnam.fly.dev",
    "NEXT_PUBLIC_LANDNAM_ENV": "production"
  },
  "env": {
    "staging": {
      "name": "landnam-web-staging",
      "workers_dev": true,
      "routes": [],
      "vars": {
        "NEXT_PUBLIC_SHARED_PB_URL": "https://signal-k-starsailors.fly.dev",
        "NEXT_PUBLIC_LANDNAM_PB_URL": "https://signal-k-landnam.fly.dev",
        "NEXT_PUBLIC_LANDNAM_ENV": "staging"
      }
    }
  }
}
