.row { position: absolute; left: 16px; bottom: 16px; z-index: 9; display: flex; flex-wrap: wrap; gap: 8px; margin: 0; padding: 0; list-style: none; max-width: calc(100% - 32px); }
.badge { display: inline-flex; align-items: center; gap: 8px; min-height: 44px; padding: 8px 12px; border-radius: 8px; border: 1px solid var(--ln-hairline-strong); background: var(--ln-panel); color: var(--ln-text); font-family: var(--ln-font-body); font-size: 14px; }
.tier { font-family: var(--ln-font-mono); font-size: 14px; font-weight: 800; letter-spacing: 0.04em; text-transform: uppercase; }
.medallion { width: 32px; height: 32px; flex: none; }
.medallion[data-tier="silver"] { filter: grayscale(1); }
.gold { border-color: var(--ln-cyan-border); }
.gold .tier { color: var(--ln-cyan); }
.silver .tier { color: var(--ln-text-muted); }
[data-wsw-tone] { border-left-width: 6px; }
[data-wsw-tone='blue'] { border-left-color: var(--ln-bp-blue); }
[data-wsw-tone='sky'] { border-left-color: var(--ln-cyan); }
[data-wsw-tone='green'] { border-left-color: var(--ln-bp-green); }
[data-wsw-tone='crimson'] { border-left-color: var(--ln-crimson); }
[data-wsw-tone='dim'] { border-left-color: var(--ln-text-muted); }
[data-wsw-tone='ink'] { border-left-color: var(--ln-text); }
