    {
      "id": "contract-construction",
      "title": "Construction contract",
      "family": "contract",
      "summary": "A client wants a structure raised: haul the materials, feed the blueprint, raise it.",
      "vehicle": "lander",
      "match": {
        "ids": [],
        "id_prefixes": [],
        "tags": [
          "CONSTRUCT"
        ]
      },
      "beats": [
        {
          "id": "brief",
          "label": "Contract",
          "view": "board",
          "goal": "See the blueprint, the materials it needs and the pay.",
          "controls": [
            "accept"
          ],
          "repeat": false
        },
        {
          "id": "gather",
          "label": "Gather",
          "view": "field",
          "goal": "Mine the materials over as many runs as it takes.",
          "controls": [
            "drive",
            "laser",
            "cargo"
          ],
          "repeat": true
        },
        {
          "id": "haul",
          "label": "Haul",
          "view": "map",
          "goal": "Fly the materials to the build site.",
          "controls": [
            "ignite",
            "stage",
            "hop"
          ],
          "repeat": false
        },
        {
          "id": "build",
          "label": "Build",
          "view": "base",
          "goal": "Drag materials onto the glowing parts of the blueprint, then raise it.",
          "controls": [
            "feed-blueprint",
            "raise"
          ],
          "repeat": false
        },
        {
          "id": "debrief",
          "label": "Debrief",
          "view": "debrief",
          "goal": "Hand over the structure and get paid.",
          "controls": [
            "store"
          ],
          "repeat": false
        }
      ],
      "controls": [
        "accept",
        "drive",
        "laser",
        "cargo",
        "ignite",
        "stage",
        "hop",
        "feed-blueprint",
        "raise",
        "store"
      ],
      "outcome": {
        "success": "The structure stands at the client's site.",
        "fail": "The contract window closes before it is raised."
      }
    },
    {
      "id": "contract-delivery",
      "title": "Delivery and relay contract",
      "family": "contract",
      "summary": "A client needs cargo dropped at a depot on another body. Straight deliveries load at home; relays mine at one body and drop at a second.",
