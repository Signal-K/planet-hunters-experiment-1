        {
          "id": "lift",
          "label": "Lift off",
          "view": "field",
          "goal": "Drive back aboard and take off.",
          "controls": [
            "take-off"
          ],
          "repeat": false,
          "method": "rover"
        },
        {
          "id": "return",
          "label": "Fly home",
          "view": "map",
          "goal": "Hop home.",
          "controls": [
            "hop"
          ],
          "repeat": false
        },
        {
          "id": "debrief",
          "label": "Debrief",
          "view": "debrief",
          "goal": "Hand over the order and get paid.",
          "controls": [
            "store",
            "sell"
          ],
          "repeat": false
