        "hop",
        "choose",
        "dock",
        "unload",
        "take-off",
        "store"
      ],
      "outcome": {
        "success": "Every crate reaches the depot and the vehicle gets home.",
        "fail": "Out of fuel between legs, or hard docking cracks the cargo."
