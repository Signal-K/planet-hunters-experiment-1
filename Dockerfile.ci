# Use Node 20 as the base image (mimics ubuntu-latest with setup-node@v4)
FROM node:20-bullseye

# Install system dependencies
# These include dependencies for Godot (headless) and Playwright
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    unzip \
    wget \
    jq \
    ca-certificates \
    git \
    libgl1 \
    libfontconfig1 \
    libx11-6 \
    libxcursor1 \
    libxinerama1 \
    libxrandr2 \
    libxi6 \
    libdbus-1-3 \
    libnss3 \
    libatk1.0-0 \
    libatk-bridge2.0-0 \
    libcups2 \
    libdrm2 \
    libxkbcommon0 \
    libxcomposite1 \
    libxdamage1 \
    libxfixes3 \
    libxrandr2 \
    libgbm1 \
    libpango-1.0-0 \
    libcairo2 \
    libasound2 \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Install Godot 4.5-stable
RUN mkdir -p /opt/godot && \
    curl -fsSL -o /opt/godot/godot.zip "https://github.com/godotengine/godot/releases/download/4.5-stable/Godot_v4.5-stable_linux.x86_64.zip" && \
    unzip /opt/godot/godot.zip -d /opt/godot && \
    mv /opt/godot/Godot_v4.5-stable_linux.x86_64 /opt/godot/godot && \
    chmod +x /opt/godot/godot && \
    rm /opt/godot/godot.zip

# Install Godot Export Templates
RUN mkdir -p /root/.local/share/godot/export_templates/4.5.stable && \
    curl -fsSL -o /tmp/templates.tpz "https://github.com/godotengine/godot/releases/download/4.5-stable/Godot_v4.5-stable_export_templates.tpz" && \
    unzip /tmp/templates.tpz -d /tmp/godot-templates && \
    cp -R /tmp/godot-templates/templates/* /root/.local/share/godot/export_templates/4.5.stable/ && \
    rm -rf /tmp/templates.tpz /tmp/godot-templates

# Add Godot to PATH
ENV PATH="/opt/godot:${PATH}"
ENV GODOT_EDITOR="/opt/godot/godot"

# Copy package files and local dependencies first for better caching
COPY package.json package-lock.json* yarn.lock* borndotcom-react-native-godot-v1.0.1.tgz* ./

# Install dependencies (using npm install instead of ci to fix the lock file issue if needed, 
# but we will try npm ci first in the Makefile to see if it works after we sync it)
RUN npm install --legacy-peer-deps

# Install all Playwright browsers and their system dependencies
RUN npx playwright install --with-deps chromium webkit firefox

# Copy the rest of the application
COPY . .

# Default command
CMD ["npm", "test"]
