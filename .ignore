# ripgrep ignore file: rg (Codex, Claude Code Grep, Cursor search) skips these paths.
# Mirror of .cursorignore. Override for one search with: rg -uu PATTERN PATH

# Dependencies and build output
node_modules/
**/node_modules/
web/.next/
web/.next-*/
web/.open-next/
web/.wrangler/
web/out/
web/tsconfig.tsbuildinfo
**/.build/
**/DerivedData/
native/Landnam.xcodeproj/
**/*.xcodeproj/
build/
dist/
coverage/
__pycache__/
pocketbase/pb_data/
sandbox/

# Test output, logs, snapshots
web/tests/.out/
web/tests/.report/
test-results/
**/__snapshots__/
*.log
*.snap

# Lockfiles and sums
web/package-lock.json
**/package-lock.json
**/go.sum

# Generated code and data (edit the source, not these)
native/App/Theme.generated.swift
**/*-sheet.json
web/public/game/assets/
native/App/Resources/Art/
native/App/Assets.xcassets/
native/**/Fixtures/
web/vendor/
tools/sprites/output/
docs/landscape-playfield/

# Design-kit bundles (huge, generated; the skill README/SKILL.md stay visible)
.agents/skills/landnam-design/_ds_bundle.js
.agents/skills/landnam-design/_ds_manifest.json
.agents/skills/landnam-design/ui_kits/landnam-portrait/screens-pre.tsx
.agents/skills/landnam-design/preview/
.agents/skills/landnam-design/fonts/
.agents/skills/landnam-design/assets/

# Archived / legacy
archive/

# Binary art and media
*.png
*.jpg
*.jpeg
*.webp
*.gif
*.psd
*.blend
*.glb
*.gltf
*.mp3
*.wav
*.ogg
*.mp4
