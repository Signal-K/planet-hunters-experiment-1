[gd_scene load_steps=2 format=3 uid="uid://simple_detail"]

[ext_resource type="Script" path="res://Scripts/UI/SimpleDetail/SimpleDetailView.gd" id="1_simple"]

[node name="SimpleDetailView" type="VBoxContainer"]
size_flags_horizontal = 3
size_flags_vertical = 3
