[gd_scene load_steps=9 format=3]

; In-game PostHog survey overlay — shown when a survey event fires in native (editor/desktop) mode.
; Static shell: backdrop, panel, header, scroll container, footer.
; Questions are populated dynamically in SurveyOverlay.gd because the count and types are runtime data.

[ext_resource type="Script" path="res://Scripts/UI/SurveyOverlay.gd" id="1"]

