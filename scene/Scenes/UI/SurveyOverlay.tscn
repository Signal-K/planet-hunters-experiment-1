[node name="SurveyOverlay" type="CanvasLayer"]
layer = 90
script = ExtResource("1")

[node name="Backdrop" type="ColorRect" parent="."]
color = Color(0.008, 0.024, 0.059, 0.85)
anchors_preset = 15
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 1

[node name="Center" type="CenterContainer" parent="."]
anchors_preset = 15
grow_horizontal = 2
grow_vertical = 2

[node name="Panel" type="PanelContainer" parent="Center"]
custom_minimum_size = Vector2(600, 0)
theme_override_styles/panel = SubResource("StyleBoxFlat_panel")

[node name="OuterVBox" type="VBoxContainer" parent="Center/Panel"]
layout_mode = 2
theme_override_constants/separation = 0

[node name="HeaderMargin" type="MarginContainer" parent="Center/Panel/OuterVBox"]
