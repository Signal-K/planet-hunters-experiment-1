[gd_scene load_steps=2 format=3]

; One status row: KEY_LABEL ············· STATUS_TEXT ●
; StatusRow.gd exposes set_status(key, text, color) for runtime updates.
; Default color is STATUS_OK green; override at instantiation or via set_status().

[ext_resource type="Script" path="res://Scenes/UI/Components/StatusRow.gd" id="1_statusrow"]

[node name="StatusRow" type="HBoxContainer"]
script = ExtResource("1_statusrow")
theme_override_constants/separation = 8

[node name="KeyLabel" type="Label" parent="."]
layout_mode = 2
size_flags_horizontal = 3
text = "SYSTEM_STATUS"
theme_override_colors/font_color = Color(0.663, 0.722, 0.808, 1.0)
theme_override_font_sizes/font_size = 22

[node name="StatusLabel" type="Label" parent="."]
layout_mode = 2
text = "NOMINAL"
theme_override_colors/font_color = Color(0.086, 0.639, 0.290, 1.0)
theme_override_font_sizes/font_size = 22

[node name="Dot" type="ColorRect" parent="."]
custom_minimum_size = Vector2(10, 10)
color = Color(0.086, 0.639, 0.290, 1.0)
