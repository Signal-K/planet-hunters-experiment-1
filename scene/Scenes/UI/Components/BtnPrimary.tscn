[node name="BtnPrimary" type="Button"]
custom_minimum_size = Vector2(0, 48)
size_flags_horizontal = 3
text = "CONFIRM"
theme_override_styles/normal = SubResource("StyleBoxFlat_normal")
theme_override_styles/hover = SubResource("StyleBoxFlat_hover")
theme_override_styles/pressed = SubResource("StyleBoxFlat_pressed")
theme_override_styles/disabled = SubResource("StyleBoxFlat_disabled")
theme_override_styles/focus = SubResource("StyleBoxFlat_normal")
theme_override_colors/font_color = Color(1.0, 1.0, 1.0, 1.0)
theme_override_colors/font_hover_color = Color(1.0, 1.0, 1.0, 1.0)
theme_override_colors/font_pressed_color = Color(1.0, 1.0, 1.0, 1.0)
theme_override_colors/font_disabled_color = Color(1.0, 1.0, 1.0, 0.5)
theme_override_colors/font_focus_color = Color(1.0, 1.0, 1.0, 1.0)
theme_override_font_sizes/font_size = 28
