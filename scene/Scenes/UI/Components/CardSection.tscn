[gd_scene load_steps=3 format=3]

; Dashboard module card — SURFACE_LOWEST, xl radius (24px), Cyan-Mist shadow.
; Structure: status micro-bar → tonal header (SURFACE_LOW) → content area.
; No dividers — use 24px vertical spacing in the Content VBox instead.
; Set SectionIndex.text ("01."), SectionTitle.text, add children to Content.

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_outer"]
bg_color = Color(0.071, 0.133, 0.212, 1.0)
corner_radius_top_left = 24
corner_radius_top_right = 24
corner_radius_bottom_right = 24
corner_radius_bottom_left = 24
shadow_color = Color(0.0, 0.0, 0.0, 0.35)
shadow_size = 24
shadow_offset = Vector2(0, 10)
content_margin_left = 0.0
content_margin_top = 0.0
content_margin_right = 0.0
content_margin_bottom = 0.0

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_header"]
bg_color = Color(0.055, 0.094, 0.157, 1.0)
corner_radius_top_left = 0
corner_radius_top_right = 0
corner_radius_bottom_right = 0
corner_radius_bottom_left = 0
content_margin_left = 20.0
content_margin_top = 14.0
content_margin_right = 20.0
content_margin_bottom = 14.0

[node name="CardSection" type="PanelContainer"]
theme_override_styles/panel = SubResource("StyleBoxFlat_outer")

[node name="OuterVBox" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 0

[node name="MicroBar" type="ColorRect" parent="OuterVBox"]
layout_mode = 2
custom_minimum_size = Vector2(0, 3)
color = Color(0.776, 0.933, 0.667, 1.0)

[node name="Header" type="PanelContainer" parent="OuterVBox"]
layout_mode = 2
theme_override_styles/panel = SubResource("StyleBoxFlat_header")

[node name="SectionRow" type="HBoxContainer" parent="OuterVBox/Header"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="SectionIndex" type="Label" parent="OuterVBox/Header/SectionRow"]
layout_mode = 2
text = "01."
theme_override_colors/font_color = Color(0.247, 0.663, 1.0, 1.0)
theme_override_font_sizes/font_size = 22

[node name="SectionTitle" type="Label" parent="OuterVBox/Header/SectionRow"]
layout_mode = 2
size_flags_horizontal = 3
text = "SECTION"
theme_override_colors/font_color = Color(0.902, 0.937, 1.0, 1.0)
theme_override_font_sizes/font_size = 22

[node name="ContentMargin" type="MarginContainer" parent="OuterVBox"]
layout_mode = 2
theme_override_constants/margin_left = 20
theme_override_constants/margin_top = 16
theme_override_constants/margin_right = 20
theme_override_constants/margin_bottom = 20

[node name="Content" type="VBoxContainer" parent="OuterVBox/ContentMargin"]
layout_mode = 2
theme_override_constants/separation = 24
