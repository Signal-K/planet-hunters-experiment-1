[gd_scene load_steps=6 format=3]

; System overlay modal — frosted SURFACE_BRIGHT backdrop, xl-radius panel.
; No border; Cyan-Mist shadow distinguishes panel from backdrop.
; Wire CancelBtn.pressed and ConfirmBtn.pressed in the parent scene.
; Set TitleLabel.text, BodyLabel.text, and button label texts.

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_panel"]
bg_color = Color(0.071, 0.133, 0.212, 1.0)
corner_radius_top_left = 24
corner_radius_top_right = 24
corner_radius_bottom_right = 24
corner_radius_bottom_left = 24
shadow_color = Color(0.0, 0.0, 0.0, 0.55)
shadow_size = 40
shadow_offset = Vector2(0, 16)
content_margin_left = 36.0
content_margin_top = 32.0
content_margin_right = 36.0
content_margin_bottom = 32.0

; ConfirmBtn primary (DS Command Cyan)
[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_confirm_normal"]
bg_color = Color(0.247, 0.663, 1.0, 1.0)
corner_radius_top_left = 12
corner_radius_top_right = 12
corner_radius_bottom_right = 12
corner_radius_bottom_left = 12
content_margin_left = 24.0
content_margin_top = 14.0
content_margin_right = 24.0
content_margin_bottom = 14.0

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_confirm_hover"]
bg_color = Color(0.192, 0.537, 0.835, 1.0)
corner_radius_top_left = 12
corner_radius_top_right = 12
corner_radius_bottom_right = 12
corner_radius_bottom_left = 12
content_margin_left = 24.0
content_margin_top = 14.0
content_margin_right = 24.0
content_margin_bottom = 14.0

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_confirm_pressed"]
bg_color = Color(0.145, 0.416, 0.659, 1.0)
corner_radius_top_left = 12
corner_radius_top_right = 12
corner_radius_bottom_right = 12
corner_radius_bottom_left = 12
content_margin_left = 24.0
content_margin_top = 14.0
content_margin_right = 24.0
content_margin_bottom = 14.0

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_confirm_disabled"]
bg_color = Color(0.247, 0.663, 1.0, 0.35)
corner_radius_top_left = 12
corner_radius_top_right = 12
corner_radius_bottom_right = 12
corner_radius_bottom_left = 12
content_margin_left = 24.0
content_margin_top = 14.0
content_margin_right = 24.0
content_margin_bottom = 14.0

[node name="ModalBase" type="CanvasLayer"]
layer = 80

[node name="Backdrop" type="ColorRect" parent="."]
color = Color(0.02, 0.035, 0.059, 0.85)
anchors_preset = 15
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 0

[node name="Center" type="CenterContainer" parent="."]
anchors_preset = 15
grow_horizontal = 2
grow_vertical = 2

[node name="Panel" type="PanelContainer" parent="Center"]
custom_minimum_size = Vector2(580, 0)
theme_override_styles/panel = SubResource("StyleBoxFlat_panel")

[node name="VBox" type="VBoxContainer" parent="Center/Panel"]
layout_mode = 2
theme_override_constants/separation = 24

[node name="TitleLabel" type="Label" parent="Center/Panel/VBox"]
layout_mode = 2
text = "MODAL TITLE"
theme_override_colors/font_color = Color(0.902, 0.937, 1.0, 1.0)
theme_override_font_sizes/font_size = 42

[node name="BodyLabel" type="Label" parent="Center/Panel/VBox"]
layout_mode = 2
text = "Confirm this action?"
autowrap_mode = 3
theme_override_colors/font_color = Color(0.663, 0.722, 0.808, 1.0)
theme_override_font_sizes/font_size = 28

[node name="ButtonRow" type="HBoxContainer" parent="Center/Panel/VBox"]
layout_mode = 2
theme_override_constants/separation = 12
alignment = 2

[node name="CancelBtn" type="Button" parent="Center/Panel/VBox/ButtonRow"]
layout_mode = 2
custom_minimum_size = Vector2(120, 48)
text = "CANCEL"

[node name="ConfirmBtn" type="Button" parent="Center/Panel/VBox/ButtonRow"]
layout_mode = 2
custom_minimum_size = Vector2(140, 48)
text = "CONFIRM"
theme_override_styles/normal = SubResource("StyleBoxFlat_confirm_normal")
theme_override_styles/hover = SubResource("StyleBoxFlat_confirm_hover")
theme_override_styles/pressed = SubResource("StyleBoxFlat_confirm_pressed")
theme_override_styles/disabled = SubResource("StyleBoxFlat_confirm_disabled")
theme_override_styles/focus = SubResource("StyleBoxFlat_confirm_normal")
theme_override_colors/font_color = Color(1.0, 1.0, 1.0, 1.0)
theme_override_colors/font_hover_color = Color(1.0, 1.0, 1.0, 1.0)
theme_override_colors/font_pressed_color = Color(1.0, 1.0, 1.0, 1.0)
theme_override_colors/font_disabled_color = Color(1.0, 1.0, 1.0, 0.5)
theme_override_colors/font_focus_color = Color(1.0, 1.0, 1.0, 1.0)
theme_override_font_sizes/font_size = 28
