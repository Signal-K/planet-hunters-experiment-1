[gd_scene load_steps=2 format=3]

; Compact telemetry chip — SURFACE_LOW tonal bg, no border.
; Top row: icon glyph + muted stat name. Bottom: large value in on-surface.
; Override IconLabel.text, NameLabel.text, ValueLabel.text in parent scene.
; e.g.  ◎ SONAR_RANGE      ♨ CORE_TEMP
;           1,240 m             420°K

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_chip"]
bg_color = Color(0.055, 0.094, 0.157, 1.0)
corner_radius_top_left = 12
corner_radius_top_right = 12
corner_radius_bottom_right = 12
corner_radius_bottom_left = 12
content_margin_left = 16.0
content_margin_top = 14.0
content_margin_right = 16.0
content_margin_bottom = 14.0

[node name="StatChip" type="PanelContainer"]
theme_override_styles/panel = SubResource("StyleBoxFlat_chip")

[node name="VBox" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 6

[node name="TopRow" type="HBoxContainer" parent="VBox"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="IconLabel" type="Label" parent="VBox/TopRow"]
layout_mode = 2
text = "◎"
theme_override_colors/font_color = Color(0.247, 0.663, 1.0, 1.0)
theme_override_font_sizes/font_size = 22

[node name="NameLabel" type="Label" parent="VBox/TopRow"]
layout_mode = 2
size_flags_horizontal = 3
text = "STAT_NAME"
theme_override_colors/font_color = Color(0.663, 0.722, 0.808, 1.0)
theme_override_font_sizes/font_size = 24

[node name="ValueLabel" type="Label" parent="VBox"]
layout_mode = 2
text = "—"
theme_override_colors/font_color = Color(0.902, 0.937, 1.0, 1.0)
theme_override_font_sizes/font_size = 42
