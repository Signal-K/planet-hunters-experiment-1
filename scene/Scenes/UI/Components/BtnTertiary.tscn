[gd_scene load_steps=3 format=3]

; Tertiary / ghost command trigger — no background, PRIMARY text, uppercase label.
; Use for low-priority actions or inline text links.
; Set .text and connect .pressed in the parent scene.

[sub_resource type="StyleBoxEmpty" id="StyleBoxEmpty_transparent"]

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_hover"]
bg_color = Color(0.0, 0.424, 0.361, 0.08)
corner_radius_top_left = 8
corner_radius_top_right = 8
corner_radius_bottom_right = 8
corner_radius_bottom_left = 8
content_margin_left = 16.0
content_margin_top = 10.0
content_margin_right = 16.0
content_margin_bottom = 10.0

[node name="BtnTertiary" type="Button"]
custom_minimum_size = Vector2(0, 40)
text = "VIEW LOGS"
theme_override_styles/normal = SubResource("StyleBoxEmpty_transparent")
theme_override_styles/hover = SubResource("StyleBoxFlat_hover")
theme_override_styles/pressed = SubResource("StyleBoxFlat_hover")
theme_override_styles/disabled = SubResource("StyleBoxEmpty_transparent")
theme_override_styles/focus = SubResource("StyleBoxEmpty_transparent")
theme_override_colors/font_color = Color(0.0, 0.424, 0.361, 1.0)
theme_override_colors/font_hover_color = Color(0.0, 0.353, 0.298, 1.0)
theme_override_colors/font_pressed_color = Color(0.0, 0.282, 0.235, 1.0)
theme_override_colors/font_disabled_color = Color(0.0, 0.424, 0.361, 0.4)
theme_override_colors/font_focus_color = Color(0.0, 0.424, 0.361, 1.0)
theme_override_font_sizes/font_size = 28
flat = true
