size_flags_horizontal = 3
theme_override_colors/font_color = Color(0.247, 0.663, 1, 1)
theme_override_font_sizes/font_size = 20
text = "MINERAL MARKET"

[node name="CloseButton" type="Button" parent="OuterMargin/PanelVBox/HeaderRow"]
layout_mode = 2
theme_override_colors/font_color = Color(0.62, 0.68, 0.78, 1)
text = "Close"

[node name="SubtitleLabel" type="Label" parent="OuterMargin/PanelVBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.62, 0.68, 0.78, 1)
theme_override_font_sizes/font_size = 12
text = "Prices fluctuate with every sale. Hold minerals to sell when prices recover."
