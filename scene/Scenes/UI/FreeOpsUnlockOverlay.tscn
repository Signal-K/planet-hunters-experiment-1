size_flags_vertical = 3
theme_override_constants/margin_left = 28
theme_override_constants/margin_top = 0
theme_override_constants/margin_right = 28
theme_override_constants/margin_bottom = 0

; ContentVBox is the direct layout parent — test paths expect TitleRow here.
; CardBackdrop (layout_mode=1) renders the card visual without disrupting layout.
[node name="ContentVBox" type="VBoxContainer" parent="RootVBox/ContentMargin"]
layout_mode = 2
size_flags_vertical = 3
theme_override_constants/separation = 18

; Dark navy card background — anchored to fill ContentVBox, z_index behind content
