[gd_scene format=3]

[node name="MenuDiscoveryRow" type="HBoxContainer"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 14

[node name="IconLabel" type="Label" parent="."]
layout_mode = 2
theme_override_font_sizes/font_size = 22
text = "☄"

[node name="Info" type="VBoxContainer" parent="."]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 4

[node name="NameLabel" type="Label" parent="Info"]
layout_mode = 2
theme_override_font_sizes/font_size = 28
text = "Discovery"

[node name="TimestampLabel" type="Label" parent="Info"]
layout_mode = 2
theme_override_font_sizes/font_size = 24
text = "Discovered: 2026-01-01"

[node name="BadgeLabel" type="Label" parent="Info"]
layout_mode = 2
theme_override_font_sizes/font_size = 24
text = "First discovery"
