[ext_resource type="FontFile" uid="uid://danwfpay16dxk" path="res://Resources/Fonts/Oxanium-SemiBold.ttf" id="3_oxanium_semi"]

; Dark glass card — matches design spec backdrop-filter glass card
[sub_resource type="StyleBoxFlat" id="SB_card"]
bg_color = Color(0.039, 0.071, 0.114, 0.88)
border_color = Color(0.247, 0.663, 1.0, 0.40)
corner_radius_top_left = 12
corner_radius_top_right = 12
corner_radius_bottom_right = 12
corner_radius_bottom_left = 12
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
shadow_color = Color(0.0, 0.0, 0.0, 0.4)
shadow_size = 12
shadow_offset = Vector2(0, 6)

; CTA button — flat pill, default cyan (overridden at runtime via EarthBaseProgressionCards)
[sub_resource type="StyleBoxFlat" id="SB_cta"]
bg_color = Color(0.247, 0.663, 1.0, 1.0)
corner_radius_top_left = 999
corner_radius_top_right = 999
corner_radius_bottom_left = 999
corner_radius_bottom_right = 999
content_margin_left = 20.0
content_margin_right = 20.0
content_margin_top = 8.0
content_margin_bottom = 8.0

[node name="EarthBaseActionCard" type="PanelContainer"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_styles/panel = SubResource("SB_card")
script = ExtResource("1")

; ── Layout: left accent bar + content area side by side ───────────────────────
[node name="RowLayout" type="HBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 0

; Left colored accent bar — width 5 px, full card height
; Color set at runtime by EarthBaseProgressionCards._configure_card()
[node name="AccentBar" type="ColorRect" parent="RowLayout"]
layout_mode = 2
custom_minimum_size = Vector2(5, 0)
size_flags_vertical = 3
color = Color(0.247, 0.663, 1.0, 1.0)

; Content margin wrapper
[node name="ContentMargin" type="MarginContainer" parent="RowLayout"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/margin_left = 16
theme_override_constants/margin_top = 14
theme_override_constants/margin_right = 16
theme_override_constants/margin_bottom = 14

[node name="Body" type="VBoxContainer" parent="RowLayout/ContentMargin"]
layout_mode = 2
theme_override_constants/separation = 8

; Eyebrow label — uppercase muted text, identifies card category
[node name="Title" type="Label" parent="RowLayout/ContentMargin/Body"]
layout_mode = 2
theme_override_colors/font_color = Color(0.247, 0.663, 1.0, 0.85)
theme_override_fonts/font = ExtResource("2_oxanium")
theme_override_font_sizes/font_size = 20
text = "Title"
uppercase = true

; Subtitle — the main body sentence
[node name="Subtitle" type="Label" parent="RowLayout/ContentMargin/Body"]
layout_mode = 2
theme_override_colors/font_color = Color(0.820, 0.882, 0.980, 0.90)
theme_override_fonts/font = ExtResource("3_oxanium_semi")
theme_override_font_sizes/font_size = 22
autowrap_mode = 3
text = "Subtitle"

; Optional hint text (hidden by default)
[node name="Hint" type="Label" parent="RowLayout/ContentMargin/Body"]
layout_mode = 2
visible = false
theme_override_colors/font_color = Color(0.620, 0.706, 0.863, 0.70)
theme_override_font_sizes/font_size = 19
autowrap_mode = 3
text = "Hint"

[node name="Spacer" type="Control" parent="RowLayout/ContentMargin/Body"]
layout_mode = 2
custom_minimum_size = Vector2(0, 4)

; CTA action button
[node name="CTAButton" type="Button" parent="RowLayout/ContentMargin/Body"]
