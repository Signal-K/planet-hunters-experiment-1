[gd_scene format=3]

[node name="LaunchWizardRocketCard" type="PanelContainer"]
size_flags_horizontal = 3

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 2
theme_override_constants/margin_left = 20
theme_override_constants/margin_top = 16
theme_override_constants/margin_right = 20
theme_override_constants/margin_bottom = 16

[node name="VBox" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="HeaderRow" type="HBoxContainer" parent="Margin/VBox"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="NameLabel" type="Label" parent="Margin/VBox/HeaderRow"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_font_sizes/font_size = 20
text = "Starter Rocket 1"

[node name="StatusLabel" type="Label" parent="Margin/VBox/HeaderRow"]
layout_mode = 2
theme_override_font_sizes/font_size = 14
vertical_alignment = 1
text = "AVAILABLE"

[node name="StatsRow" type="HBoxContainer" parent="Margin/VBox"]
layout_mode = 2
theme_override_constants/separation = 24

[node name="RangeChip" type="VBoxContainer" parent="Margin/VBox/StatsRow"]
layout_mode = 2
theme_override_constants/separation = 2

[node name="KeyLabel" type="Label" parent="Margin/VBox/StatsRow/RangeChip"]
layout_mode = 2
theme_override_font_sizes/font_size = 13
text = "RANGE"

[node name="ValueLabel" type="Label" parent="Margin/VBox/StatsRow/RangeChip"]
layout_mode = 2
theme_override_font_sizes/font_size = 17
text = "12.0 AU"

[node name="CostChip" type="VBoxContainer" parent="Margin/VBox/StatsRow"]
layout_mode = 2
theme_override_constants/separation = 2

[node name="KeyLabel" type="Label" parent="Margin/VBox/StatsRow/CostChip"]
layout_mode = 2
theme_override_font_sizes/font_size = 13
text = "COST"

[node name="ValueLabel" type="Label" parent="Margin/VBox/StatsRow/CostChip"]
layout_mode = 2
theme_override_font_sizes/font_size = 17
text = "1.0B F"

[node name="DurationChip" type="VBoxContainer" parent="Margin/VBox/StatsRow"]
layout_mode = 2
theme_override_constants/separation = 2

[node name="KeyLabel" type="Label" parent="Margin/VBox/StatsRow/DurationChip"]
layout_mode = 2
theme_override_font_sizes/font_size = 13
text = "DURATION"

[node name="ValueLabel" type="Label" parent="Margin/VBox/StatsRow/DurationChip"]
layout_mode = 2
theme_override_font_sizes/font_size = 17
text = "60 min"

[node name="SelectButton" type="Button" parent="Margin/VBox"]
custom_minimum_size = Vector2(0, 48)
layout_mode = 2
size_flags_horizontal = 3
theme_override_font_sizes/font_size = 16
text = "Select"
