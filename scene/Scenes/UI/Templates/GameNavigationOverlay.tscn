[gd_scene format=3]

[node name="Overlay" type="ColorRect"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
mouse_filter = 1
color = Color(0, 0, 0, 0.55)

[node name="Center" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
mouse_filter = 1

[node name="Panel" type="PanelContainer" parent="Center"]
layout_mode = 2

[node name="Content" type="VBoxContainer" parent="Center/Panel"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="Header" type="HBoxContainer" parent="Center/Panel/Content"]
layout_mode = 2

[node name="Title" type="Label" parent="Center/Panel/Content/Header"]
layout_mode = 2
size_flags_horizontal = 3
text = "Overlay"

[node name="CloseButton" type="Button" parent="Center/Panel/Content/Header"]
layout_mode = 2
text = "Close"

[node name="Separator" type="HSeparator" parent="Center/Panel/Content"]
layout_mode = 2

[node name="Subtitle" type="Label" parent="Center/Panel/Content"]
layout_mode = 2
text = "Subtitle"

[node name="Scroll" type="ScrollContainer" parent="Center/Panel/Content"]
layout_mode = 2
size_flags_vertical = 3

[node name="Body" type="VBoxContainer" parent="Center/Panel/Content/Scroll"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 8
