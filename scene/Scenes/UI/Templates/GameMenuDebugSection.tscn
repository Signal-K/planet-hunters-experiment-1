[gd_scene format=3]

[node name="GameMenuDebugSection" type="VBoxContainer"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="InstantMiningButton" type="Button" parent="."]
layout_mode = 2
text = "DEBUG: Start Instant Mining"

[node name="MoneyButton" type="Button" parent="."]
layout_mode = 2
text = "DEBUG: Grant 10M Francs"

[node name="MissionLabel" type="Label" parent="."]
layout_mode = 2
theme_override_font_sizes/font_size = 16
text = "Jump to Mission:"

[node name="MissionRow" type="HBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 8

[node name="Mission1Button" type="Button" parent="MissionRow"]
custom_minimum_size = Vector2(80, 50)
layout_mode = 2
text = "M1"

[node name="Mission2Button" type="Button" parent="MissionRow"]
custom_minimum_size = Vector2(80, 50)
layout_mode = 2
text = "M2"

[node name="Mission3Button" type="Button" parent="MissionRow"]
custom_minimum_size = Vector2(80, 50)
layout_mode = 2
text = "M3"

[node name="Mission4Button" type="Button" parent="MissionRow"]
custom_minimum_size = Vector2(80, 50)
layout_mode = 2
text = "M4"

[node name="Mission5Button" type="Button" parent="MissionRow"]
custom_minimum_size = Vector2(80, 50)
layout_mode = 2
text = "M5"
