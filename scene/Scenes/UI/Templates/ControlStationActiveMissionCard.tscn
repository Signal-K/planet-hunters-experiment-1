[gd_scene format=3]

[node name="ControlStationActiveMissionCard" type="PanelContainer"]
layout_mode = 2
size_flags_horizontal = 3

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 2
theme_override_constants/margin_left = 18
theme_override_constants/margin_top = 16
theme_override_constants/margin_right = 18
theme_override_constants/margin_bottom = 16

[node name="HBox" type="HBoxContainer" parent="Margin"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 16

[node name="ContentVBox" type="VBoxContainer" parent="Margin/HBox"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 6

[node name="RocketLabel" type="Label" parent="Margin/HBox/ContentVBox"]
layout_mode = 2
text = "Rocket"

[node name="TargetLabel" type="Label" parent="Margin/HBox/ContentVBox"]
layout_mode = 2
autowrap_mode = 3
text = "Target"

[node name="ResumeButton" type="Button" parent="Margin/HBox"]
custom_minimum_size = Vector2(150, 44)
layout_mode = 2
text = "RESUME"
