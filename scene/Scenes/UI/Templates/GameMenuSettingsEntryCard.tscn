[gd_scene format=3]

[node name="GameMenuSettingsEntryCard" type="PanelContainer"]
custom_minimum_size = Vector2(0, 150)
layout_mode = 2

[node name="Body" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 12

[node name="TopRow" type="HBoxContainer" parent="Body"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="TextColumn" type="VBoxContainer" parent="Body/TopRow"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 8

[node name="EyebrowLabel" type="Label" parent="Body/TopRow/TextColumn"]
layout_mode = 2
text = "TACTICAL SETTINGS"

[node name="TitleLabel" type="Label" parent="Body/TopRow/TextColumn"]
layout_mode = 2
text = "Command Console"

[node name="SummaryLabel" type="Label" parent="Body/TopRow/TextColumn"]
layout_mode = 2
size_flags_horizontal = 3
autowrap_mode = 3
text = "Stitch-inspired tactical settings with current mission actions and progress controls."

[node name="OpenButton" type="Button" parent="Body/TopRow"]
custom_minimum_size = Vector2(220, 64)
layout_mode = 2
size_flags_vertical = 4
text = "Open Settings"

[node name="FootnoteLabel" type="Label" parent="Body"]
layout_mode = 2
autowrap_mode = 3
text = "Includes Practice Mining, Replay Guide, Dialogue toggle, and Reset Progress."
