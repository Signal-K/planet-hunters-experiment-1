[gd_scene format=3]

[node name="AsteroidClassificationRow" type="VBoxContainer"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 8

[node name="PromptLabel" type="Label" parent="."]
layout_mode = 2
text = "Classify this target:"

[node name="NoteLabel" type="Label" parent="."]
layout_mode = 2
autowrap_mode = 3
text = "Classification note"

[node name="ClassificationButtons" type="HFlowContainer" parent="."]
layout_mode = 2
theme_override_constants/h_separation = 8
theme_override_constants/v_separation = 8

[node name="BtnPlanet" type="Button" parent="ClassificationButtons"]
layout_mode = 2
text = "Planet"

[node name="BtnNotPlanet" type="Button" parent="ClassificationButtons"]
layout_mode = 2
text = "Not a Planet"

[node name="BtnMarkDip" type="Button" parent="ClassificationButtons"]
layout_mode = 2
text = "Mark Dip"
