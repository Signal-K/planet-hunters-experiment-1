[gd_scene format=3]

; Terminal Ethereal — SURFACE_LOWEST card, 16px radius, Cyan-Mist shadow, no border.
; Header: SURFACE_LOW tonal band. Chart area: SURFACE_LOW. Badge: secondary_fixed.

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_card"]
bg_color = Color(0.071, 0.133, 0.212, 1.0)
corner_radius_top_left = 16
corner_radius_top_right = 16
corner_radius_bottom_right = 16
corner_radius_bottom_left = 16
shadow_color = Color(0.0, 0.0, 0.0, 0.45)
shadow_size = 12
shadow_offset = Vector2(0, 4)
content_margin_left = 0.0
content_margin_top = 0.0
content_margin_right = 0.0
content_margin_bottom = 0.0

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_chart"]
bg_color = Color(0.039, 0.071, 0.114, 1.0)
corner_radius_top_left = 8
corner_radius_top_right = 8
corner_radius_bottom_right = 8
corner_radius_bottom_left = 8

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_badge"]
bg_color = Color(0.776, 0.933, 0.667, 1.0)
corner_radius_top_left = 6
corner_radius_top_right = 6
corner_radius_bottom_right = 6
corner_radius_bottom_left = 6
content_margin_left = 8.0
content_margin_top = 3.0
content_margin_right = 8.0
content_margin_bottom = 3.0

[node name="TargetClassificationCard" type="PanelContainer"]
custom_minimum_size = Vector2(280, 0)
layout_mode = 2
theme_override_styles/panel = SubResource("StyleBoxFlat_card")

[node name="OuterVBox" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 0

[node name="MicroBar" type="ColorRect" parent="OuterVBox"]
layout_mode = 2
custom_minimum_size = Vector2(0, 3)
color = Color(0.776, 0.933, 0.667, 1.0)

[node name="ContentMargin" type="MarginContainer" parent="OuterVBox"]
layout_mode = 2
theme_override_constants/margin_left = 20
theme_override_constants/margin_top = 18
theme_override_constants/margin_right = 20
theme_override_constants/margin_bottom = 18

[node name="VBox" type="VBoxContainer" parent="OuterVBox/ContentMargin"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="HeaderRow" type="HBoxContainer" parent="OuterVBox/ContentMargin/VBox"]
layout_mode = 2
theme_override_constants/separation = 4

[node name="TargetIdLabel" type="Label" parent="OuterVBox/ContentMargin/VBox/HeaderRow"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_colors/font_color = Color(0.902, 0.937, 1.0, 1.0)
theme_override_font_sizes/font_size = 28
text = "TIC-0000"

[node name="TypeIcon" type="Label" parent="OuterVBox/ContentMargin/VBox/HeaderRow"]
layout_mode = 2
theme_override_colors/font_color = Color(0.663, 0.722, 0.808, 0.72)
theme_override_font_sizes/font_size = 24
text = "◎"

[node name="ChartPanel" type="PanelContainer" parent="OuterVBox/ContentMargin/VBox"]
custom_minimum_size = Vector2(0, 120)
layout_mode = 2
theme_override_styles/panel = SubResource("StyleBoxFlat_chart")

[node name="ChartWave" type="Label" parent="OuterVBox/ContentMargin/VBox/ChartPanel"]
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
grow_horizontal = 2
grow_vertical = 2
theme_override_colors/font_color = Color(0.247, 0.663, 1.0, 0.25)
theme_override_font_sizes/font_size = 20
text = "~ ~ ~ ~ ~"
horizontal_alignment = 1
vertical_alignment = 1

[node name="ConsensusLabel" type="Label" parent="OuterVBox/ContentMargin/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.663, 0.722, 0.808, 1.0)
theme_override_font_sizes/font_size = 24
text = "CONSENSUS"

[node name="VerdictLabel" type="Label" parent="OuterVBox/ContentMargin/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.086, 0.639, 0.290, 1.0)
theme_override_font_sizes/font_size = 28
text = "Agreement"

[node name="ActiveMissionBadge" type="PanelContainer" parent="OuterVBox/ContentMargin/VBox"]
visible = false
layout_mode = 2
theme_override_styles/panel = SubResource("StyleBoxFlat_badge")

[node name="BadgeLabel" type="Label" parent="OuterVBox/ContentMargin/VBox/ActiveMissionBadge"]
layout_mode = 2
theme_override_colors/font_color = Color(0.286, 0.412, 0.0, 1.0)
theme_override_font_sizes/font_size = 24
text = "△ ACTIVE MISSION"
horizontal_alignment = 1
