[node name="TargetClassificationCard" type="PanelContainer"]
custom_minimum_size = Vector2(180, 0)
layout_mode = 2
theme_override_styles/panel = SubResource("StyleBoxFlat_card")

[node name="VBox" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 8

[node name="HeaderRow" type="HBoxContainer" parent="VBox"]
layout_mode = 2
theme_override_constants/separation = 4

[node name="TargetIdLabel" type="Label" parent="VBox/HeaderRow"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_colors/font_color = Color(0.92, 0.95, 0.98, 1.0)
theme_override_font_sizes/font_size = 14
text = "TIC-0000"

[node name="TypeIcon" type="Label" parent="VBox/HeaderRow"]
layout_mode = 2
theme_override_colors/font_color = Color(0.55, 0.68, 0.80, 0.72)
theme_override_font_sizes/font_size = 14
text = "◎"

[node name="ChartPanel" type="PanelContainer" parent="VBox"]
custom_minimum_size = Vector2(0, 86)
layout_mode = 2
theme_override_styles/panel = SubResource("StyleBoxFlat_chart")

[node name="ChartWave" type="Label" parent="VBox/ChartPanel"]
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
grow_horizontal = 2
grow_vertical = 2
theme_override_colors/font_color = Color(0.28, 0.70, 0.88, 0.45)
theme_override_font_sizes/font_size = 11
text = "~ ~ ~ ~ ~"
horizontal_alignment = 1
vertical_alignment = 1

[node name="Separator" type="HSeparator" parent="VBox"]
layout_mode = 2

[node name="ConsensusLabel" type="Label" parent="VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.50, 0.62, 0.72, 1.0)
theme_override_font_sizes/font_size = 10
text = "CONSENSUS"

[node name="VerdictLabel" type="Label" parent="VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.28, 0.90, 0.65, 1.0)
theme_override_font_sizes/font_size = 14
text = "Agreement"

[node name="ActiveMissionBadge" type="PanelContainer" parent="VBox"]
visible = false
layout_mode = 2
