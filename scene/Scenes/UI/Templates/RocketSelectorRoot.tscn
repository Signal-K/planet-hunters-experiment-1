[gd_scene format=3]

[node name="SelectorRoot" type="VBoxContainer"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
theme_override_constants/separation = 14

[node name="Heading" type="Label" parent="."]
layout_mode = 2
horizontal_alignment = 0
text = "Available Rockets"

[node name="Subheading" type="Label" parent="."]
layout_mode = 2
horizontal_alignment = 0
text = "Choose your vehicle. Drag the rocket image or press Create."

[node name="CardsWrap" type="ScrollContainer" parent="."]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
horizontal_scroll_mode = 0

[node name="Cards" type="VBoxContainer" parent="CardsWrap"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 12
