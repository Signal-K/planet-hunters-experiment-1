[gd_scene format=3]

[node name="RocketCard" type="PanelContainer"]
layout_mode = 2
size_flags_horizontal = 1
size_flags_vertical = 1

[node name="Body" type="VBoxContainer" parent="."]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
theme_override_constants/separation = 12

[node name="RocketTexture" type="TextureRect" parent="Body"]
layout_mode = 2
size_flags_horizontal = 3
custom_minimum_size = Vector2(0, 180)
expand_mode = 1
stretch_mode = 6

[node name="NameLabel" type="Label" parent="Body"]
layout_mode = 2
horizontal_alignment = 1

[node name="Chips" type="GridContainer" parent="Body"]
layout_mode = 2
columns = 2
size_flags_horizontal = 3
theme_override_constants/h_separation = 10
theme_override_constants/v_separation = 8

[node name="EconomyLabel" type="Label" parent="Body"]
layout_mode = 2
horizontal_alignment = 1

[node name="Spacer" type="Control" parent="Body"]
layout_mode = 2
size_flags_vertical = 3

[node name="CreateButton" type="Button" parent="Body"]
custom_minimum_size = Vector2(0, 62)
layout_mode = 2
size_flags_horizontal = 3
text = "Create"
