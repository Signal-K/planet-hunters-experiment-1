; ── Top scrim ────────────────────────────────────────────────────────────
[sub_resource type="Shader" id="Sh_top"]
code = "shader_type canvas_item;
void fragment() {
	float a = max(0.0, 1.0 - UV.y * 3.5) * 0.88;
	COLOR = vec4(0.024, 0.035, 0.059, a);
}"
[sub_resource type="ShaderMaterial" id="Mat_top"]
shader = SubResource("Sh_top")

; ── Bottom scrim ─────────────────────────────────────────────────────────
[sub_resource type="Shader" id="Sh_bot"]
code = "shader_type canvas_item;
void fragment() {
	float a = max(0.0, UV.y * 3.5 - 2.5) * 0.95;
	COLOR = vec4(0.024, 0.035, 0.059, a);
}"
[sub_resource type="ShaderMaterial" id="Mat_bot"]
shader = SubResource("Sh_bot")

