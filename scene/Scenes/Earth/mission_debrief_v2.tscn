; ── Green hero circle glow (radial gradient shader) ──────────────────────
[sub_resource type="Shader" id="Sh_hero"]
code = "shader_type canvas_item;
void fragment() {
	vec2 uv = UV * 2.0 - 1.0;
	float d = length(uv);
	float circle = smoothstep(0.86, 0.78, d);
	float glow = max(0.0, 0.85 - d * 1.1) * 0.45;
	COLOR = vec4(0.224, 0.827, 0.416, circle * 0.95 + glow * 0.55);
}"
[sub_resource type="ShaderMaterial" id="Mat_hero"]
shader = SubResource("Sh_hero")

