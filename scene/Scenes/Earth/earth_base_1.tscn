; ── Radial navigation — bottom center ───────────────────────────────────
; COORDINATE SYSTEM (all anchored to screen bottom-center):
;   anchor_left=0.5, anchor_top=1.0, anchor_right=0.5, anchor_bottom=1.0
;   offset_top = -(center_from_bottom + half_height)    [negative = above bottom]
;   offset_bottom = -(center_from_bottom - half_height)  [negative = above bottom]
;   offset_left = center_dx - half_width   [negative = left of center]
;   offset_right = center_dx + half_width
;
; Prototype (402px canvas): hub=64px, radius=96px, arc 150° centered at 90°
; Scale to Godot (1080px): × (1080/402) = × 2.686
;   hub size = 172px → rounded to 140px
;   satellite size = 145px → using 140px
;   radius = 258px, hub_center_from_bottom = 120px
;
; Arc angles (start=-165°, step=50°, N=4):
;   i=0 BASE     angle=-165°  dx=cos(-165°)×258=-249  dy=sin(-165°)×258=-67
;   i=1 MISSIONS angle=-115°  dx=cos(-115°)×258=-109  dy=sin(-115°)×258=-234
;   i=2 ATLAS    angle=-65°   dx=cos(-65°)×258=+109   dy=sin(-65°)×258=-234
;   i=3 BUILD    angle=-15°   dx=cos(-15°)×258=+249   dy=sin(-15°)×258=-67
; (dy negative = upward in screen space = MORE from bottom)
; center_from_bottom = hub_center(120) + |dy|

[node name="RadialNav" type="Control" parent="Root"]
z_index = 30
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2

; BASE: center_from_bottom=187, center_x=-249, btn 140×140 (half=70)
[node name="BaseBtn" type="Button" parent="Root/RadialNav"]
