anchor_top = 1.0
anchor_right = 0.5
anchor_bottom = 1.0
offset_left = -319.0
offset_top = -257.0
offset_right = -179.0
offset_bottom = -117.0
grow_horizontal = 2
grow_vertical = 0
visible = false
custom_minimum_size = Vector2(140.0, 140.0)
text = "BASE"
theme_override_fonts/font = ExtResource("4_semi")
theme_override_font_sizes/font_size = 20
theme_override_colors/font_color = Color(0.224, 0.827, 0.416, 1.0)
