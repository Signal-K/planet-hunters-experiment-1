; Engine configuration file.
; Fresh Landnam prototype generated from the supplied Claude design system.

config_version=5

[application]

config/name="Landnam Design System Prototype"
run/main_scene="res://Scenes/Main.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")
config/icon="res://design_system_source/assets/icons/godot-icon.svg"

[display]

window/size/viewport_width=402
window/size/viewport_height=874
window/size/mode=2
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
