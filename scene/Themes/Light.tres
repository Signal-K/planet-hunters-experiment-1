[resource]
; Panels
Panel/styles/panel = SubResource("StyleBoxFlat_card")
PanelContainer/styles/panel = SubResource("StyleBoxFlat_card")

; Button (secondary / default)
Button/styles/normal = SubResource("StyleBoxFlat_btn_normal")
Button/styles/hover = SubResource("StyleBoxFlat_btn_hover")
Button/styles/pressed = SubResource("StyleBoxFlat_btn_pressed")
Button/styles/disabled = SubResource("StyleBoxFlat_btn_disabled")
Button/styles/focus = SubResource("StyleBoxFlat_btn_focus")
Button/colors/font_color = Color(0.059, 0.090, 0.165, 1)
Button/colors/font_hover_color = Color(0.059, 0.090, 0.165, 1)
Button/colors/font_pressed_color = Color(0.059, 0.090, 0.165, 1)
Button/colors/font_disabled_color = Color(0.392, 0.455, 0.545, 0.5)
Button/colors/font_focus_color = Color(0.059, 0.090, 0.165, 1)
Button/font_sizes/font_size = 34

; Label
Label/colors/font_color = Color(0.059, 0.090, 0.165, 1)
Label/font_sizes/font_size = 36

; RichTextLabel
RichTextLabel/colors/default_color = Color(0.059, 0.090, 0.165, 1)
RichTextLabel/font_sizes/normal_font_size = 36
RichTextLabel/font_sizes/bold_font_size = 36

; ProgressBar
ProgressBar/styles/background = SubResource("StyleBoxFlat_prog_bg")
ProgressBar/styles/fill = SubResource("StyleBoxFlat_prog_fill")
ProgressBar/colors/font_color = Color(0.059, 0.090, 0.165, 1)

; ScrollContainer (transparent bg)
ScrollContainer/styles/panel = SubResource("StyleBoxEmpty_transparent")

; Separators
HSeparator/styles/separator = SubResource("StyleBoxLine_sep")
VSeparator/styles/separator = SubResource("StyleBoxLine_sep")
