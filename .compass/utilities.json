{
  "utilities": [
    {
      "id": "sprite-generator",
      "name": "Sprite Generator",
      "description": "Generate spaceship part sprites via Replicate (Flux). Requires REPLICATE_API_TOKEN in web/.env.local",
      "command": "python3",
      "args": ["tools/sprites/generate_sprite.py"],
      "cwd": ".",
      "params": [
        {
          "key": "prompt",
          "label": "Visual prompt",
          "type": "text",
          "flag": "--prompt",
          "placeholder": "Single sprite: describe what to generate…"
        },
        {
          "key": "batch",
          "label": "Sprite batch (JSON)",
          "type": "text",
          "flag": "--batch",
          "placeholder": "[{\"name\":\"main_stage_t1\",\"prompt\":\"...\",\"aspect_ratio\":\"1:2\"}]"
        },
        {
          "key": "name",
          "label": "Sprite name",
          "type": "string",
          "default": "new_part",
          "flag": "--name",
          "placeholder": "e.g. ion_thruster_t3"
        },
        {
          "key": "count",
          "label": "Count",
          "type": "int",
          "default": 1,
          "flag": "--count",
          "placeholder": "1"
        },
        {
          "key": "aspect_ratio",
          "label": "Aspect ratio",
          "type": "string",
          "default": "1:1",
          "flag": "--aspect-ratio",
          "placeholder": "1:1, 1:2, 2:3, 9:16…"
        },
        {
          "key": "model",
          "label": "Quality",
          "type": "string",
          "default": "schnell",
          "flag": "--model",
          "placeholder": "schnell or pro"
        },
        {
          "key": "outDir",
          "label": "Output dir",
          "type": "path",
          "default": "web/public/parts/_generated",
          "flag": "--out-dir",
          "placeholder": "web/public/parts/_generated"
        }
      ],
      "nlTranslation": {
        "enabled": true,
        "promptTemplate": "The user wants to generate sprites for a space game called Landnam (a land-management / space-mining game). Their request: \"{input}\". Convert this into parameters: {params}. Rules: SINGLE sprite: set 'name' (snake_case, no extension) and 'prompt' (detailed Flux description, white background, side-view for rocket parts). MULTI-sprite/system/sheet: set 'batch' to a compact JSON array like [{\"name\":\"...\",\"prompt\":\"...\",\"aspect_ratio\":\"1:2\"}] — leave 'name' and 'prompt' empty. Aspect ratios: 1:1 square parts, 1:2 or 2:3 for tall rocket stages. Model: 'schnell' default, 'pro' if user says final/best. Return ONLY a JSON object."
      },
      "output": {
        "type": "imageGallery",
        "glob": "{outDir}/**/*.png"
      },
      "actions": [
        {
          "id": "move-to-parts",
          "label": "Move to parts/",
          "type": "move",
          "destination": "web/public/parts"
        },
        {
          "id": "copy-to-parts",
          "label": "Copy to parts/",
          "type": "copy",
          "destination": "web/public/parts"
        },
        {
          "id": "delete",
          "label": "Delete",
          "type": "delete"
        },
        {
          "id": "regenerate",
          "label": "Regenerate",
          "type": "rerun"
        }
      ]
    }
  ]
}
