# Dockerfile.sandbox — Mission flow sandbox with Xvfb + VNC + noVNC
# Runs the full M1→M2→M3→Free-Ops Godot scene and outputs screenshots/reports.
FROM ubuntu:22.04

ARG GODOT_VERSION=4.5-stable
ENV DEBIAN_FRONTEND=noninteractive \
    GODOT_BIN=/usr/local/bin/godot \
    PROJECT_PATH=/app/scene \
    OUTPUT_DIR=/output \
    DISPLAY=:99

# ── System deps ───────────────────────────────────────────────────────────────
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl unzip ca-certificates \
    xvfb x11vnc \
    libgl1-mesa-dri libgl1-mesa-glx libegl1 libgles2 \
    mesa-utils libglib2.0-0 libdbus-1-3 \
    libxcursor1 libxi6 libxrandr2 libxinerama1 libxss1 libxkbcommon0 \
    libasound2 \
    python3 python3-pip python3-setuptools \
    websockify \
    fonts-liberation \
    && rm -rf /var/lib/apt/lists/*

# ── Godot headless binary ─────────────────────────────────────────────────────
RUN curl -fsSL -o /tmp/godot.zip \
    "https://github.com/godotengine/godot/releases/download/${GODOT_VERSION}/Godot_v${GODOT_VERSION}_linux.x86_64.zip" \
  && unzip -q /tmp/godot.zip -d /tmp/godot \
  && mv "/tmp/godot/Godot_v${GODOT_VERSION}_linux.x86_64" "$GODOT_BIN" \
  && chmod +x "$GODOT_BIN" \
  && rm -rf /tmp/godot /tmp/godot.zip

# ── noVNC ─────────────────────────────────────────────────────────────────────
RUN curl -fsSL https://github.com/novnc/noVNC/archive/refs/tags/v1.4.0.tar.gz \
    | tar -xz -C /opt && mv /opt/noVNC-1.4.0 /opt/novnc \
  && curl -fsSL https://github.com/novnc/websockify/archive/refs/tags/v0.11.0.tar.gz \
    | tar -xz -C /opt && mv /opt/websockify-0.11.0 /opt/websockify \
  && ln -s /opt/websockify /opt/novnc/utils/websockify

# ── Project source ────────────────────────────────────────────────────────────
COPY scene/ /app/scene/
RUN mkdir -p /output

# ── Entrypoint ────────────────────────────────────────────────────────────────
COPY sandbox/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

EXPOSE 5900 6080

ENTRYPOINT ["/entrypoint.sh"]
