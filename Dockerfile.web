# Dockerfile.web — Local dev/test image that mirrors the CI environment.
#
# Node version matches the CI workflow (setup-node@v4 with node-version: "20").
# Serves the web shell via dev-server.js on PORT (default 3333).
#
# Usage (via docker-compose.web.yml):
#   docker compose -f docker-compose.web.yml --profile test  up --build   # run Jest
#   docker compose -f docker-compose.web.yml --profile serve up --build   # open localhost:3333

FROM node:20-alpine

RUN apk add --no-cache bash curl ca-certificates

WORKDIR /app

# Install dependencies first (layer-cached unless lockfile changes).
# The local file: dep must be present before yarn install runs.
COPY package.json yarn.lock* package-lock.json* borndotcom-react-native-godot-v1.0.1.tgz* ./
RUN yarn install --frozen-lockfile --non-interactive

# Copy the rest of the project (node_modules and .env are in .dockerignore)
COPY . .

ENV PORT=3333
ENV HOST=0.0.0.0
ENV NODE_ENV=development

EXPOSE 3333

CMD ["node", "dev-server.js"]
