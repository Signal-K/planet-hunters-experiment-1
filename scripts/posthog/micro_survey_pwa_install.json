{
  "name": "Landnám: PWA Install Motivation",
  "type": "external_survey",
  "schedule": "always",
  "enable_partial_responses": true,
  "appearance": {
    "displayThankYouMessage": true,
    "thankYouMessageHeader": "Thanks!",
    "thankYouMessageDescription": "Knowing why you installed helps us build a better app."
  },
  "questions": [
    {
      "type": "multiple_choice",
      "question": "Why did you install Landnám to your home screen?",
      "choices": ["Faster to open", "Plays better full-screen", "Saves mobile data", "Just wanted to try it", "Someone recommended it"],
      "descriptionContentType": "text"
    },
    {
      "type": "rating",
      "scale": 5,
      "display": "number",
      "question": "How likely are you to keep it installed?",
      "lowerBoundLabel": "Very unlikely",
      "upperBoundLabel": "Definitely keeping it",
      "descriptionContentType": "text"
    }
  ]
}
