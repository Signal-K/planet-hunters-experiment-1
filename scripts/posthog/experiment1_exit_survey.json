{
  "name": "Experiment 1 Exit Survey (Godot build)",
  "type": "external_survey",
  "schedule": "always",
  "enable_partial_responses": true,
  "appearance": {
    "displayThankYouMessage": true,
    "thankYouMessageHeader": "Thanks for testing Experiment 1",
    "thankYouMessageDescription": "Your feedback helps shape how this prototype connects into the Star Sailors web game."
  },
  "questions": [
    {
      "type": "rating",
      "scale": 5,
      "display": "number",
      "question": "How easy was it to complete your first mission?",
      "description": "1 = very hard, 5 = very easy",
      "lowerBoundLabel": "Very hard",
      "upperBoundLabel": "Very easy",
      "descriptionContentType": "text"
    },
    {
      "type": "multiple_choice",
      "question": "Where did you get stuck first?",
      "choices": [
        "Finding targets",
        "Building a rocket",
        "Launching a mission",
        "Mining resources",
        "Mission debrief / payout",
        "UI navigation",
        "I did not get stuck"
      ],
      "descriptionContentType": "text"
    },
    {
      "type": "multiple_choice",
      "question": "What should we fix first before a wider release?",
      "choices": [
        "UI clarity",
        "Tutorial and onboarding",
        "Performance",
        "Mission pacing",
        "Reward balance",
        "Bug fixes"
      ],
      "descriptionContentType": "text"
    },
    {
      "type": "open",
      "question": "Citizen science tasks are coming in the next build. What would help you understand how your in-game actions contribute to real science?",
      "description": "Example: data quality feedback, clear goals, impact summaries, or review workflows.",
      "descriptionContentType": "text"
    },
    {
      "type": "multiple_choice",
      "question": "Which science mission tracks would you most want to play next?",
      "choices": [
        "Exoplanet hunting",
        "Radio signal classification",
        "Star and nebula discovery",
        "Asteroid and comet missions",
        "Planet weather tracking",
        "Solar activity and sunspots"
      ],
      "shuffleOptions": true,
      "descriptionContentType": "text"
    },
    {
      "type": "multiple_choice",
      "question": "Which feature would make you come back this week?",
      "choices": [
        "Co-op or social play",
        "Clear progression map",
        "More mission types",
        "Deeper base-building",
        "Narrative events",
        "Leaderboards"
      ],
      "descriptionContentType": "text"
    },
    {
      "type": "multiple_choice",
      "question": "If progress carries between Experiment 1 and the Star Sailors web game, what should carry over?",
      "choices": [
        "XP and level",
        "Mission logbook",
        "Unlocks",
        "Science contributions",
        "Cosmetics and ship style"
      ],
      "descriptionContentType": "text"
    },
    {
      "type": "multiple_choice",
      "question": "After completing a mission, what should happen next?",
      "choices": [
        "Suggested next mission",
        "Return to Star Sailors hub",
        "Compare results with other players",
        "See science impact summary",
        "End session quickly"
      ],
      "descriptionContentType": "text"
    },
    {
      "type": "open",
      "question": "What is one change that would make this prototype feel clearly connected to the wider Star Sailors world?",
      "descriptionContentType": "text"
    }
  ]
}
